{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxNode",
  "version": "0.1.0",
  "identifier": "com.fluxnode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FluxNode",
        "width": 1440,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
