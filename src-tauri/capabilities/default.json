{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for FluxNode workspace and detached panel windows",
  "windows": [
    "main",
    "fluxnode-panel-preview",
    "fluxnode-panel-timeline",
    "fluxnode-panel-inspector"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:path:default",
    "core:window:default",
    "updater:default",
    "process:allow-restart"
  ]
}
